# ── LLM-Anbieter ───────────────────────────────────────────
# anthropic | gemini | offline (ohne API-Key, regelbasierte Vermerke) | mock (Tests)
LLM_PROVIDER=offline

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096

# ── Prüflogik ──────────────────────────────────────────────
PRICE_TOLERANCE_PCT=2.0
MAX_CORRECTION_RETRIES=2

# ── Datenbank & SQL-Guardrail ──────────────────────────────
FLOWAUDIT_DB_PATH=data/flowaudit_erp.db
# FLOWAUDIT_DATA_DIR=data   # Datenordner für Cockpit/CLI (optional)
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=3

# ── KI-Anbieter (Agenten-Standard v1) ──────────────────────
# mock | offline (ohne API-Key, regelbasierte Vermerke) | claude | gemini
# (ältere Schreibweise LLM_PROVIDER=anthropic|gemini|offline wird weiterhin akzeptiert)
LLM_ANBIETER=offline

# Schlüssel nie einchecken – alternativ im macOS-Schlüsselbund:
#   security add-generic-password -s "FlowAudit-AI" -a "ANTHROPIC_API_KEY" -w
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

LLM_TEMPERATUR=0
LLM_MAX_TOKENS=4096

# ── Prüflogik ──────────────────────────────────────────────
PRICE_TOLERANCE_PCT=2.0
# zulässige Mehrberechnung ggü. offener Bestell-/WE-Menge in % (0 = keine Überlieferung erlaubt)
QUANTITY_TOLERANCE_PCT=0
MAX_CORRECTION_RETRIES=2

# ── Datenbank & SQL-Guardrail ──────────────────────────────
FLOWAUDIT_DB_PATH=data/flowaudit_erp.db
# FLOWAUDIT_DATA_DIR=data   # Datenordner für Cockpit/CLI (optional)
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=3

# ── Laufzeit (setzt der Desktop-Launcher selbst) ───────────
# AGENT_LAUFZEIT=lokal      # nur für den Browser auf dem eigenen Rechner: Umschalter hell/dunkel + gespeicherte Wahl
LOG_LEVEL=WARNING
